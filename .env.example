# Required for answering questions. Retrieval and evaluation do not use OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# demo: launches demo_server.py over MCP stdio (default)
# remote: connects to MCP_REMOTE_URL over Streamable HTTP
MCP_MODE=demo
MCP_REMOTE_URL=https://mcp.atlassian.com/v2/mcp

# Full Authorization header value for remote mode, for example:
# MCP_AUTH_HEADER=Bearer your-service-account-api-key
# MCP_AUTH_HEADER=Basic base64-encoded-email-and-api-token
MCP_AUTH_HEADER=

# Optional comma-separated allowlist. When empty, only tools whose names look
# read-only (search/get/list/discover/executeRead) are exposed to the LLM.
MCP_ALLOWED_TOOLS=

MAX_TOOL_ROUNDS=4
MAX_TOOL_CALLS=8
MAX_PAGES=5
MAX_CONTEXT_CHARS=24000

